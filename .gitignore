# One file for the whole repo. Patterns without a folder prefix apply to both
# projects; the sections below them are scoped to one.

node_modules/
dist/
*.log
.DS_Store

# Real notes identify real people -- never commit them, wherever they land.
.env
*.fixture.html
nfce-fixture.html
*.db
*.db-shm
