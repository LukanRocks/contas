# Copy to .env here, in v2/. It is gitignored.

# Used by `pnpm dev`, `pnpm db:migrate` and `pnpm seed:demo` on the host. The
# api container builds its own URL to the db service (docker-compose.yml).
DATABASE_URL=postgres://contas:contas@localhost:5432/contas

# The disposable database the test suite runs against. Created by
# docker/postgres/init-test-db.sql on the db volume's first start.
DATABASE_URL_TEST=postgres://contas:contas@localhost:5432/contas_test

# HTTP port: the server's in `pnpm dev`, the published one in Docker Compose.
# PORT=3000

# Reported by /health; the Docker build passes a git tag or short SHA.
# APP_VERSION=

# Where users can get this server's source, linked from /docs. The AGPL requires offering it
# if you run a modified version, so point it at your fork. Defaults to the upstream repository.
# SOURCE_URL=https://github.com/LukanRocks/contas

# Docker Compose only.
# POSTGRES_USER=contas
# POSTGRES_PASSWORD=contas
# POSTGRES_DB=contas
# DB_PORT=5432
