# Copy to .env at the workspace root. Everything here is optional.
# .env is gitignored: these values point at real notes, which identify real
# people (a scanned NFC-e carries the buyer's CPF).

# A captured NFC-e page. When set, the parser and ingest tests run against it;
# when unset, those tests skip. Relative paths resolve from the workspace root.
# Capture one with:
#   pnpm --filter @contas/backend fixture:capture "<qr-url>"
# NFCE_FIXTURE=data/nfce-fixture.html

# A QR URL the web app offers behind an example button, for testing the
# ingest flow by hand. The button is hidden when this is unset.
# NFCE_SAMPLE_URL=https://www.fazenda.pr.gov.br/nfce/qrcode?p=<44-digit-chave>%7C3%7C1

# PORT=3000
# DATABASE_PATH=data/contas.db
